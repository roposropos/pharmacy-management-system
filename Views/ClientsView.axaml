<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Apteka.ViewModels"
             xmlns:c="using:Apteka.Views.Components"
             xmlns:apteka="clr-namespace:Apteka"
             xmlns:grid="clr-namespace:Apteka.ViewModels.Grid"
             x:Class="Apteka.Views.ClientsView"
             x:DataType="vm:ClientsViewModel">
    <UserControl.Resources>
        <apteka:RowConverter x:Key="RowConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
                <c:IconButton Text="Wstecz" Icon="ArrowLeft" Command="{Binding GoBack}" />
                <TextBlock Text="Klienci" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <c:SearchWidget Grid.Row="1" />
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="{Binding !IsEditing}"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="1" BorderBrush="Gray"
                      Margin="10"
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.Styles>
                    <Style Selector="DataGridRow" x:DataType="grid:KlientViewModel">
                        <Setter Property="Background"
                                Value="{Binding IsModified, Converter={StaticResource RowConverter}}" />
                    </Style>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                    <DataGridTextColumn Header="Imię i Nazwisko" Binding="{Binding ImieNazwisko}" Width="*" />
                    <DataGridTextColumn Header="PESEL" Binding="{Binding PeselDisplay}" Width="150" />
                    <DataGridTextColumn Header="Telefony" Binding="{Binding Telefony}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <c:CrudActions Grid.Row="3" Margin="0, 0, 10, 10" HorizontalAlignment="Right" />
            <StackPanel Grid.Row="4" VerticalAlignment="Center"
                        IsEnabled="{Binding IsEditing}"
                        Spacing="5">
                <StackPanel.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style Selector="Grid">
                        <Setter Property="Margin" Value="10, 0" />
                    </Style>
                </StackPanel.Styles>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="ID: " />
                    <TextBox Grid.Column="1" IsEnabled="False" Text="{Binding SelectedItem.Id}" />
                </Grid>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="Imię: " />
                    <TextBox Grid.Column="1" Text="{Binding SelectedItem.Imie}" />
                </Grid>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="Nazwisko: " />
                    <TextBox Grid.Column="1" Text="{Binding SelectedItem.Nazwisko}" />
                </Grid>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="PESEL: " />
                    <TextBox Grid.Column="1" Text="{Binding SelectedItem.PeselDisplay}" />
                </Grid>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="Numery: " />
                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedItem.Telefony}"
                             DoubleTapped="OnPhoneDoubleTapped" />
                </Grid>
                <Grid ColumnDefinitions="150, *">
                    <TextBlock Text="Adres: " />
                    <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding SelectedItem.Adres}"
                             DoubleTapped="OnAddressDoubleTapped" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0, 10, 10, 10"
                        Spacing="10">
                <Button Content="Zapisz" Command="{Binding SaveCommand}" />
                <Button Content="Anuluj" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
        <c:DialogHost DialogContent="{Binding CurrentDialogViewModel}"
                      IsVisible="{Binding CurrentDialogViewModel, Converter={x:Static ObjectConverters.IsNotNull}}"
                      CloseCommand="{Binding CloseDialogCommand}" />
    </Grid>
</UserControl>

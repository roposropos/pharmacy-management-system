<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Apteka.ViewModels"
             xmlns:c="using:Apteka.Views.Components"
             x:Class="Apteka.Views.DeliveriesView"
             x:DataType="vm:DeliveriesViewModel">
    <Grid RowDefinitions="Auto, *, *">
        <StackPanel Orientation="Horizontal" Margin="10" Spacing="10">
            <c:IconButton Text="Wstecz" Icon="ArrowLeft" Command="{Binding GoBackCommand}" />
            <TextBlock Text="Dostawy" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Deliveries}" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Data" Binding="{Binding DataDostawy}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="10">
            <ScrollViewer>
                <StackPanel Spacing="10" Margin="0,0,10,0">
                    <TextBlock Text="Nowa Dostawa" FontSize="18" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding PendingOrders}" SelectedItem="{Binding SelectedOrder}"
                              HorizontalAlignment="Stretch" PlaceholderText="Wybierz zamówienie (opcjonalnie)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id, StringFormat='Zamówienie #{0}'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding AvailableDrugs}" SelectedItem="{Binding SelectedDrug}"
                              HorizontalAlignment="Stretch" PlaceholderText="Wybierz lek">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nazwa}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding SelectedDrug.Lek.Warianty}"
                              SelectedItem="{Binding SelectedVariant}" HorizontalAlignment="Stretch"
                              PlaceholderText="Wybierz wariant">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Dawka}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <NumericUpDown Value="{Binding Quantity}" Minimum="1" />
                    <TextBox Text="{Binding BatchNumber}" Watermark="Numer Partii" />
                    <DatePicker SelectedDate="{Binding ExpiryDate}" />
                    <Button Content="Dodaj Pozycję" Command="{Binding AddItemCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Zapisz Dostawę" Command="{Binding SubmitDeliveryCommand}"
                            HorizontalAlignment="Stretch" Classes="accent" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Apteka.ViewModels"
             xmlns:c="using:Apteka.Views.Components"
             x:Class="Apteka.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">
    <Grid RowDefinitions="Auto, *, *">
        <StackPanel Orientation="Horizontal" Margin="10" Spacing="10">
            <c:IconButton Text="Wstecz" Icon="ArrowLeft" Command="{Binding GoBackCommand}" />
            <TextBlock Text="Zamówienia" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Data" Binding="{Binding DataUtworzenia}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="10">
            <StackPanel Spacing="10" Margin="0,0,10,0">
                <TextBlock Text="Nowe Zamówienie" FontSize="18" FontWeight="Bold" />
                <ComboBox ItemsSource="{Binding AvailableDrugs}" SelectedItem="{Binding SelectedDrug}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nazwa}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding SelectedDrug.Lek.Warianty}" SelectedItem="{Binding SelectedVariant}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Dawka}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <NumericUpDown Value="{Binding Quantity}" Minimum="1" />
                <Button Content="Dodaj Pozycję" Command="{Binding AddItemCommand}" HorizontalAlignment="Stretch" />
                <Button Content="Złóż Zamówienie" Command="{Binding PlaceOrderCommand}" HorizontalAlignment="Stretch"
                        Classes="accent" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
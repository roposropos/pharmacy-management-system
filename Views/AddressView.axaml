<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Apteka.ViewModels"
             xmlns:apteka="clr-namespace:Apteka"
             x:Class="Apteka.Views.AddressView"
             x:DataType="vm:AddressViewModel">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto, Auto, Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
            <TextBlock Text="Adresy" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    IsEnabled="{Binding IsEditing}"
                    Spacing="5">
            <StackPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Grid">
                    <Setter Property="Margin" Value="10, 0" />
                </Style>
            </StackPanel.Styles>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="ID: " />
                <TextBox Grid.Column="1" IsEnabled="False" Text="{Binding SelectedItem.Id}" MinWidth="60" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Kraj: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.Kraj}" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Ulica: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.Ulica}" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Numer Domu: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.NumerDomu}" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Numer Lokalu: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.NumerLokalu}" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Miejscowość: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.Miejscowosc}" />
            </Grid>
            <Grid ColumnDefinitions="150, *">
                <TextBlock Text="Kod Pocztowy: " />
                <TextBox Grid.Column="1" Text="{Binding SelectedItem.KodPocztowy}" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0, 10, 10, 10"
                    Spacing="10">
            <Button Content="Zapisz" Command="{Binding SaveCommand}" />
            <Button Content="Anuluj" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
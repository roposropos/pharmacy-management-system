<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Apteka.Views.Components.DialogHost"
             x:Name="Root">
    <Grid Name="RootGrid"
          IsVisible="{Binding DialogContent, ElementName=Root, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Background="Black" Opacity="0.5" />

        <Border Background="{DynamicResource SystemRegionBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="20"
                CornerRadius="8"
                BoxShadow="0 4 10 0 Black">
            <StackPanel Spacing="20">
                <ContentPresenter Content="{Binding DialogContent, ElementName=Root}" />
                <Button Content="Zamknij" HorizontalAlignment="Right"
                        Command="{Binding CloseCommand, ElementName=Root}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>